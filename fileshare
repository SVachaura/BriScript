const STORAGE_KEY = 'fileshare_files';

function getFiles() {
    const data = localStorage.getItem(STORAGE_KEY);
    return data ? JSON.parse(data) : [];
}

function saveFiles(files) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(files));
}

// ============ ЗАГРУЗКА НА CATBOX ============
async function uploadToCatbox(file, onProgress) {
    return new Promise((resolve, reject) => {
        const formData = new FormData();
        formData.append('reqtype', 'fileupload');
        formData.append('fileToUpload', file);

        const xhr = new XMLHttpRequest();
        xhr.open('POST', 'https://catbox.moe/user/api.php');

        xhr.upload.onprogress = (e) => {
            if (e.lengthComputable && onProgress) {
                onProgress((e.loaded / e.total) * 100);
            }
        };

        xhr.onload = () => {
            if (xhr.status === 200 && xhr.responseText.startsWith('https://')) {
                resolve(xhr.responseText.trim());
            } else {
                reject(new Error('Ошибка загрузки: ' + xhr.responseText));
            }
        };
        xhr.onerror = () => reject(new Error('Сетевая ошибка. Возможно, catbox.moe недоступен.'));
        xhr.send(formData);
    });
}

// ============ ОБРАБОТКА ФОРМЫ ============
async function handleUpload(e) {
    e.preventDefault();
    const alertBox = document.getElementById('alert');
    const submitBtn = document.getElementById('submitBtn');
    const progress = document.getElementById('progress');
    const progressBar = document.getElementById('progressBar');

    const name = document.getElementById('name').value.trim();
    const description = document.getElementById('description').value.trim();
    const file = document.getElementById('file').files[0];

    if (!name || !file) {
        alertBox.innerHTML = '<div class="alert error">Укажите название и выберите файл</div>';
        return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Загрузка...';
    progress.style.display = 'block';
    alertBox.innerHTML = '';

    try {
        const fileUrl = await uploadToCatbox(file, (pct) => {
            progressBar.style.width = pct + '%';
            progressBar.textContent = Math.round(pct) + '%';
        });

        const files = getFiles();
        const id = Date.now().toString(36);
        const newFile = {
            id,
            name,
            description,
            originalName: file.name,
            size: file.size,
            url: fileUrl,
            uploadedAt: new Date().toISOString()
        };
        files.unshift(newFile);
        saveFiles(files);

        alertBox.innerHTML = '<div class="alert success">✅ Файл загружен! Переход...</div>';
        setTimeout(() => {
            location.href = 'file.html?id=' + id;
        }, 800);
    } catch (err) {
        alertBox.innerHTML = '<div class="alert error">❌ ' + err.message + '</div>';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Загрузить файл';
        progress.style.display = 'none';
    }
}

// ============ СПИСОК ФАЙЛОВ ============
function renderFiles(query = '') {
    const files = getFiles();
    const list = document.getElementById('filesList');
    const emptyMsg = document.getElementById('emptyMsg');
    const alertBox = document.getElementById('alert');

    const q = query.toLowerCase();
    const filtered = q
        ? files.filter(f =>
            f.name.toLowerCase().includes(q) ||
            (f.description || '').toLowerCase().includes(q))
        : files;

    if (filtered.length === 0) {
        list.innerHTML = '';
        emptyMsg.style.display = 'block';
        emptyMsg.textContent = q
            ? 'Ничего не найдено по запросу «' + query + '»'
            : 'Файлов пока нет. Загрузите первый!';
        return;
    }
    emptyMsg.style.display = 'none';
    if (alertBox) alertBox.innerHTML = '';

    list.innerHTML = filtered.map(f => `
        <div class="file-card">
            <div class="file-header">
                <a href="file.html?id=${f.id}" class="file-name">${escapeHtml(f.name)}</a>
                <span class="badge unknown">⚠ Без проверки</span>
            </div>
            ${f.description ? `<p class="desc">${escapeHtml(f.description)}</p>` : ''}
            <div class="meta">${formatSize(f.size)} · ${formatDate(f.uploadedAt)}</div>
        </div>
    `).join('');
}

function searchFiles() {
    const q = document.getElementById('searchInput').value.trim();
    renderFiles(q);
}

// ============ СТРАНИЦА ФАЙЛА ============
function renderFilePage(id) {
    const files = getFiles();
    const f = files.find(x => x.id === id);
    const detail = document.getElementById('fileDetail');
    const title = document.getElementById('fileName');

    if (!f) {
        title.textContent = 'Файл не найден';
        detail.innerHTML = '<div class="alert error">Файл не найден или был удалён из этого браузера.</div>';
        return;
    }

    title.textContent = f.name;
    const pageLink = location.origin + location.pathname + '?id=' + id;

    detail.innerHTML = `
        ${f.description ? `<p class="desc">${escapeHtml(f.description)}</p>` : ''}
        <table class="info">
            <tr><td>Оригинальное имя:</td><td>${escapeHtml(f.originalName)}</td></tr>
            <tr><td>Размер:</td><td>${formatSize(f.size)}</td></tr>
            <tr><td>Дата загрузки:</td><td>${formatDate(f.uploadedAt)}</td></tr>
            <tr><td>Проверка:</td><td><span class="badge unknown">⚠ Антивирус не проверялся</span></td></tr>
        </table>
        <a href="${f.url}" target="_blank" class="btn btn-primary">⬇ Скачать файл</a>
        <div class="link-box">
            <p>Прямая ссылка на страницу:</p>
            <input type="text" readonly value="${pageLink}" onclick="this.select()">
            <p style="margin-top:8px;">Прямая ссылка на файл:</p>
            <input type="text" readonly value="${f.url}" onclick="this.select()">
        </div>
        <div style="margin-top:20px;">
            <button class="btn" onclick="deleteFile('${f.id}')">🗑️ Удалить из списка</button>
        </div>
    `;
}

function deleteFile(id) {
    if (!confirm('Удалить файл из списка? Сама ссылка на catbox останется рабочей.')) return;
    const files = getFiles().filter(f => f.id !== id);
    saveFiles(files);
    location.href = 'index.html';
}

// ============ УТИЛИТЫ ============
function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' Б';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' КБ';
    return (bytes / 1024 / 1024).toFixed(1) + ' МБ';
}

function formatDate(iso) {
    const d = new Date(iso);
    return d.toLocaleString('ru-RU', {
        day: '2-digit', month: '2-digit', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
    });
}

function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
